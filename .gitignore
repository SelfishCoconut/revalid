# --- University regulation PDFs and templates (kept local, linked in README) ---
docs/normativa/
docs/Plantillas TFG/
docs/*.pdf

# --- Local pentest report PDFs (kept local; not re-hosted) ---
# The real evaluation report is an external, no-license work — see tests/data/README.md.
/*.pdf

# --- Local tool caches (codebase-memory MCP index) ---
.codebase-memory/

# --- OS / editor noise ---
.DS_Store
__MACOSX/
*.swp
thesis/*.pdf

# --- Local runtime SQLite DB (never commit) ---
# Glob covers the db plus SQLite sidecars (-journal/-wal/-shm) so a WAL-mode run
# can't leave an untracked file that `git add -A` would sweep in.
/revalid.db*

# --- Session scratch space (screenshots, probe scripts) ---
/scratchpad/
