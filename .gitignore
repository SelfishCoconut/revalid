# --- Sensitive data: NEVER commit, NEVER feed to AI tools (Reglamento TFG 2026 §6) ---
data/private/
*.env
.env*
*credentials*
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- Frontend (React SPA, FR-11) ---
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/

